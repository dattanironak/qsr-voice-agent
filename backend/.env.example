# Postgres connection string (see 01-database-schema.md)
DATABASE_URL=postgresql+psycopg://qsr:qsr@localhost:5432/qsr_agent

# Public base URL of this backend (used for PayU surl/furl — PayU redirects the customer's
# browser here after payment, so this must be reachable from the internet in real deployments,
# not just localhost).
BACKEND_PUBLIC_BASE_URL=http://localhost:8000

# Public base URL of the web frontend (backend redirects here once it has processed PayU's
# success/failure callback, so the customer lands back on a receipt page).
FRONTEND_PUBLIC_BASE_URL=http://localhost:5173

# LiveKit Cloud (used by session-token endpoint / webhook data-push)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# PayU merchant credentials (test sandbox: https://test.payu.in — get test key/salt from
# https://onboarding.payu.in/ or PayU's public test credentials for sandbox testing).
# Checkout is restricted to UPI only (enforce_paymethod=upi) — no cards/netbanking/wallets.
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
PAYU_PAYMENT_URL=https://test.payu.in/_payment

# No physical receipt printer yet — when a payment succeeds, the backend saves a printable HTML
# receipt to disk and opens it in a new Chrome tab as a stand-in (staff can Cmd/Ctrl+P from
# there). Only makes sense while the backend runs on the same machine as the counter's screen —
# set to false once a real printer or a separate backend host is in place.
AUTO_OPEN_RECEIPT=true
